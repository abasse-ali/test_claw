# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/price_comparator
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/price_comparator

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Scraping configuration
SCRAPING_DELAY_MIN=2
SCRAPING_DELAY_MAX=5
SCRAPING_TIMEOUT=30
RESPECT_ROBOTS_TXT=true
USER_AGENT=PriceComparator/1.0

# Alerts configuration
ALERT_CHECK_INTERVAL_MINUTES=60
MAX_ALERTS_PER_USER=50

# External APIs
OPENSTREETMAP_API=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=  # Optional: Get from https://openweathermap.org/api

# App configuration
APP_NAME=Price Comparator
DEBUG=true
LOG_LEVEL=INFO

# Email configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=price-comparator@example.com

# File upload configuration (for product images)
MAX_UPLOAD_SIZE=5242880  # 5MB
UPLOAD_DIR=uploads/