# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/price_comparator
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/price_comparator

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Scraping
SCRAPING_DELAY_MIN=2
SCRAPING_DELAY_MAX=5
SCRAPING_TIMEOUT=30
RESPECT_ROBOTS_TXT=true
USER_AGENT=PriceComparator/1.0 (+https://github.com/yourusername/price-comparator)

# Alerts
ALERT_CHECK_INTERVAL_MINUTES=60
MAX_ALERTS_PER_USER=50

# External APIs
OPENSTREETMAP_API=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=

# App
APP_NAME=Price Comparator
DEBUG=true
LOG_LEVEL=INFO